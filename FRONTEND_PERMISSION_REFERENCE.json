  "ui_implementation_guide": {
    "permission_check_endpoint": "GET /api/auth/me - Returns user info with permissions array",
    "permission_format": "Array of permission strings like ['student.read', 'student.manage', 'class.read']",
    "checking_permissions": {
      "exact_match": "Check if permissions array includes exact permission string",
      "manage_shortcut": "If user has '{resource}.manage', grant all CRUD for that resource",
      "example_code": {
        "javascript": "function hasPermission(userPermissions, requiredPermission) {\n  // Check exact permission\n  if (userPermissions.includes(requiredPermission)) return true;\n  \n  // Check if user has .manage for this resource\n  const [resource, action] = requiredPermission.split('.');\n  if (userPermissions.includes(`${resource}.manage`)) return true;\n  \n  return false;\n}"
      }
    },
